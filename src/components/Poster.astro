---
interface Props {
  line1: string;
  line2: string;
  lead: string;
  body: string;
  stamp: string;
  image: string;
  video?: string;
  webm?: string;
  label?: string;
}
const { line1, line2, lead, body, stamp, image, video, webm, label = "Poster" } = Astro.props;
---

<section class="poster" aria-label={label}>
  <div class="poster-top">
    <h2>
      <span>{line1}</span>
      <span>{line2}</span>
    </h2>
    <div class="poster-aside">
      <p class="poster-lead">{lead}</p>
      <p class="poster-body">{body}</p>
    </div>
    <p class="poster-stamp">{stamp}</p>
  </div>
  <div class="poster-media">
    {
      video ? (
        <video data-lazy muted loop playsinline preload="none" poster={image} aria-hidden="true">
          {webm && <source data-src={webm} type="video/webm" />}
          <source data-src={video} type="video/mp4" />
        </video>
      ) : (
        <img src={image} alt="" width="1600" height="900" />
      )
    }
  </div>
</section>
