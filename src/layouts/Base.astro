---
import "../styles/global.css";
import { site, words } from "../data/site";

interface Props {
  title: string;
  description?: string;
  page?: "home" | "case";
}
const { title, description = site.description, page = "case" } = Astro.props;

// Loader line, one span per letter so the stylesheet can type it out in order.
const preRows = ["I MAKE MY", "OWN LUCK"];
const preTotal = preRows.join(" ").length;
let preIndex = 0;
const preCh = (ch: string, extra = "") => {
  const last = preIndex === preTotal - 1 ? " pre-last" : "";
  return `<span class="pre-ch${extra}${last}" style="--i:${preIndex++}">${ch}</span>`;
};
let preLineHtml = "";
preRows.forEach((row, r) => {
  row.split(" ").forEach((word, w) => {
    if (w > 0) preLineHtml += preCh("&nbsp;", " pre-sp");
    preLineHtml += `<span class="pre-word">${[...word].map((ch) => preCh(ch)).join("")}</span>`;
  });
  if (r < preRows.length - 1) preLineHtml += preCh("&nbsp;", " pre-sp pre-sp-br") + '<br class="pre-br" />';
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17171a" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/video/berlin-poster.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Anton.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PermanentMarker.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.add("reduce");
        if (window.matchMedia("(max-width: 860px)").matches) root.classList.add("is-mobile");
      })();
    </script>
  </head>
  <body data-page={page}>
    <a class="skip" href="#smooth-content">Skip to content</a>
    <span class="mark tl"></span>
    <span class="mark tr"></span>
    <span class="mark bl"></span>
    <span class="mark br"></span>
    <canvas class="ruler ruler-x" data-ruler="x" aria-hidden="true"></canvas>
    <canvas class="ruler ruler-y" data-ruler="y" aria-hidden="true"></canvas>
    <p class="readout" aria-hidden="true">
      X<span data-x>0000</span> Y<span data-y>0000</span> R<span data-r>0000</span> S<span data-s>0000</span>
    </p>
    <p id="copy-live" class="skip" aria-live="polite"></p>
    <p data-words hidden>{words.join("|")}</p>
    <div class="ink-bg">
      <video
        id="ink-video"
        class="ink-video"
        muted
        playsinline
        autoplay
        preload="auto"
        poster="/hero/berlin-hero-poster.jpg"
        aria-hidden="true"
      >
        <source src="/hero/berlin-hero.mp4" type="video/mp4" />
        <source src="/hero/berlin-hero.webm" type="video/webm" />
      </video>
      <div class="ink-dots"></div>
    </div>
    <button class="sound-toggle" type="button" aria-pressed="false" aria-label="Sound is off. Turn on a quiet drone.">
      Sound
    </button>
    <canvas id="ink" aria-hidden="true"></canvas>
    {
      page === "home" && (
        <div class="preloader" data-preloader>
          <p class="pre-name">
            <span data-pre-name>DIGVIJAY RATHORE</span>
            <i class="pre-sq" aria-hidden="true"></i>
          </p>
          <div class="pre-polaroids" data-pre-stack aria-hidden="true">
            <img src="/loader/card-1.jpg" alt="" width="420" height="462" />
            <img src="/loader/card-2.jpg" alt="" width="420" height="462" />
            <img src="/loader/card-3.jpg" alt="" width="420" height="462" />
            <img src="/loader/card-4.jpg" alt="" width="420" height="462" />
            <img src="/loader/card-5.jpg" alt="" width="420" height="462" />
            <img src="/loader/card-6.jpg" alt="" width="420" height="462" />
            <img src="/loader/card-7.jpg" alt="" width="420" height="462" />
            <img src="/loader/card-9.jpg" alt="" width="420" height="462" />
          </div>
          <p class="pre-line" role="img" aria-label="I make my own luck" set:html={preLineHtml} />
          <p class="preloader-num" data-count>000</p>
          <div class="pre-scale" aria-hidden="true">
            {Array.from({ length: 11 }, (_, i) => <i style={`left:${i * 10}%`}>{String(i * 10).padStart(3, "0")}</i>)}
          </div>
          <div class="pre-track" aria-hidden="true"><span data-pre-bar></span></div>
        </div>
      )
    }
    <slot name="fixed" />
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
      </div>
    </div>
    <script>
      import "../scripts/boot";
    </script>
    <noscript>
      <style>
        .preloader { display: none !important; }
      </style>
    </noscript>
  </body>
</html>
