---
import "../styles/global.css";
import { site, words } from "../data/site";

interface Props {
  title: string;
  description?: string;
  page?: "home" | "case";
  jsonLd?: object[];
}
const { title, description = site.description, page = "case", jsonLd = [] } = Astro.props;
// Link previews need full addresses, so the banner and page URL are built on the live domain.
const siteUrl = "https://digvijay.online";
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const bannerUrl = `${siteUrl}/og.jpg`;
// Tells search engines and AI tools who this site is about. Home page only.
const personLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  mainEntity: {
    "@type": "Person",
    "@id": `${siteUrl}/#person`,
    name: "Digvijay Rathore",
    alternateName: ["Digvijay Singh Rathore", "Diggi"],
    jobTitle: "GTM Engineer",
    description: site.description,
    url: `${siteUrl}/`,
    image: `${siteUrl}/portrait/digvijay.webp`,
    email: site.email,
    address: { "@type": "PostalAddress", addressLocality: "Berlin", addressCountry: "DE" },
    sameAs: [site.linkedin, site.github],
    knowsAbout: [
      "Go-to-market engineering",
      "Outbound automation",
      "SEO",
      "Generative engine optimization",
      "Answer engine optimization",
      "Cold email deliverability",
      "AI agents",
      "Clay",
      "HubSpot",
    ],
    alumniOf: [
      { "@type": "CollegeOrUniversity", name: "Gisma University of Applied Sciences" },
      { "@type": "CollegeOrUniversity", name: "Christ University" },
    ],
  },
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  name: "Digvijay Rathore",
  alternateName: ["Digvijay Rathore | GTM Engineer in Berlin", "digvijay.online"],
  url: `${siteUrl}/`,
  inLanguage: "en",
  publisher: { "@id": `${siteUrl}/#person` },
};

// Loader line, one span per letter so the stylesheet can type it out in order.
const preRows = ["I MAKE MY", "OWN LUCK"];
const preTotal = preRows.join(" ").length;
let preIndex = 0;
const preCh = (ch: string, extra = "") => {
  const last = preIndex === preTotal - 1 ? " pre-last" : "";
  return `<span class="pre-ch${extra}${last}" style="--i:${preIndex++}">${ch}</span>`;
};
let preLineHtml = "";
preRows.forEach((row, r) => {
  row.split(" ").forEach((word, w) => {
    if (w > 0) preLineHtml += preCh("&nbsp;", " pre-sp");
    preLineHtml += `<span class="pre-word">${[...word].map((ch) => preCh(ch)).join("")}</span>`;
  });
  if (r < preRows.length - 1) preLineHtml += preCh("&nbsp;", " pre-sp pre-sp-br") + '<br class="pre-br" />';
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17171a" />
    <link rel="canonical" href={pageUrl} />
    {page === "home" && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
    {page === "home" && <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />}
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    {page === "home" && <link rel="preload" as="image" href="/portrait/digvijay.webp" type="image/webp" fetchpriority="high" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Digvijay Rathore" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={bannerUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Digvijay Rathore, GTM Engineer in Berlin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={bannerUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/Anton.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PermanentMarker.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) root.classList.add("reduce");
        if (window.matchMedia("(max-width: 860px)").matches) root.classList.add("is-mobile");
        // The opening screen stays hidden until the display fonts are in, so the fallback font never
        // paints and then jumps. The loader covers it anyway. A timer shows it regardless after 5 s.
        var ready = function () { root.classList.add("fonts-ready"); };
        var timer = setTimeout(ready, 5000);
        if (document.fonts && document.fonts.load) {
          Promise.all([
            document.fonts.load("400 1em Anton"),
            document.fonts.load("500 1em Satoshi"),
            document.fonts.load("700 1em Satoshi"),
            document.fonts.load("1em Marker"),
          ]).then(function () { clearTimeout(timer); ready(); }, ready);
        } else ready();
      })();
    </script>
    <noscript><style>.hero-stage, .topbar, .preloader .pre-line, .preloader .preloader-num, .preloader .pre-name, .preloader .pre-scale { visibility: visible !important; }</style></noscript>
    <script is:inline>
      // Cookieless analytics. Loads only on the live domain (or with ?ph_test=1 for a local check).
      // No cookies, no browser storage, no session recordings.
      (function () {
        var host = location.hostname;
        var live = host === "digvijay.online" || host === "www.digvijay.online";
        var test = /[?&]ph_test=1/.test(location.search);
        if (!live && !test) return;
        var loader = document.createElement("script");
        loader.async = true;
        loader.src = "https://us-assets.i.posthog.com/static/array.js";
        loader.onload = function () {
          if (!window.posthog || !window.posthog.init) return;
          window.posthog.init("phc_yKwDfbCxzZdNmbm3E4LQANvyKDYsUwx3oq3ghwgVq8B9", {
            api_host: "https://us.i.posthog.com",
            cookieless_mode: "always",
            persistence: "memory",
            autocapture: true,
            capture_pageview: true,
            capture_pageleave: true,
            disable_session_recording: true,
            disable_surveys: true,
            enable_heatmaps: false,
            capture_dead_clicks: false,
            capture_performance: false,
          });
        };
        document.head.appendChild(loader);
        function track(name) {
          if (window.posthog && window.posthog.capture) window.posthog.capture(name, { page: location.pathname });
        }
        document.addEventListener(
          "click",
          function (event) {
            var el = event.target && event.target.closest ? event.target.closest("a, button") : null;
            if (!el) return;
            var href = el.getAttribute("href") || "";
            if (href.indexOf("cal.com") > -1) track("book_call_clicked");
            else if (href.indexOf("linkedin.com") > -1) track("linkedin_clicked");
            else if (href.indexOf("github.com") > -1) track("github_clicked");
            else if (href.indexOf("mailto:") === 0) track("email_clicked");
            else if (el.hasAttribute("download")) track("cv_downloaded");
            else if (el.hasAttribute("data-play-film")) track("walkthrough_played");
          },
          true,
        );
      })();
    </script>
  </head>
  <body data-page={page}>
    <a class="skip" href="#smooth-content">Skip to content</a>
    <span class="mark tl"></span>
    <span class="mark tr"></span>
    <span class="mark bl"></span>
    <span class="mark br"></span>
    <canvas class="ruler ruler-x" data-ruler="x" aria-hidden="true"></canvas>
    <canvas class="ruler ruler-y" data-ruler="y" aria-hidden="true"></canvas>
    <p class="readout" aria-hidden="true">
      X<span data-x>0000</span> Y<span data-y>0000</span> R<span data-r>0000</span> S<span data-s>0000</span>
    </p>
    <p id="copy-live" class="skip" aria-live="polite"></p>
    <p data-words hidden>{words.join("|")}</p>
    <div class="ink-bg">
      <video
        id="ink-video"
        class="ink-video"
        muted
        playsinline
        preload="none"
        poster="/hero/berlin-hero-poster-lit.jpg"
        aria-hidden="true"
      >
        <source src="/hero/berlin-hero-720.mp4" type="video/mp4" />
      </video>
      <div class="ink-dots"></div>
    </div>
    <canvas id="ink" aria-hidden="true"></canvas>
    {
      page === "home" && (
        <div class="preloader" data-preloader>
          <p class="pre-name">
            <span data-pre-name>DIGVIJAY RATHORE</span>
            <i class="pre-sq" aria-hidden="true"></i>
          </p>
          <div class="pre-polaroids" data-pre-stack aria-hidden="true">
            <img src="/loader/card-1.jpg" alt="" width="420" height="462" />
            <img src="/loader/card-2.jpg" alt="" width="420" height="462" />
            <img src="/loader/card-3.jpg" alt="" width="420" height="462" />
            <img src="/loader/card-4.jpg" alt="" width="420" height="462" fetchpriority="low" />
            <img src="/loader/card-5.jpg" alt="" width="420" height="462" fetchpriority="low" />
            <img src="/loader/card-6.jpg" alt="" width="420" height="462" fetchpriority="low" />
            <img src="/loader/card-7.jpg" alt="" width="420" height="462" fetchpriority="low" />
            <img src="/loader/card-9.jpg" alt="" width="420" height="462" fetchpriority="low" />
          </div>
          <p class="pre-line" role="img" aria-label="I make my own luck" set:html={preLineHtml} />
          <p class="preloader-num" data-count>000</p>
          <div class="pre-scale" aria-hidden="true">
            {Array.from({ length: 11 }, (_, i) => <i style={`left:${i * 10}%`}>{String(i * 10).padStart(3, "0")}</i>)}
          </div>
          <div class="pre-track" aria-hidden="true"><span data-pre-bar></span></div>
        </div>
      )
    }
    <slot name="fixed" />
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
        {
          page !== "home" && (
            <footer class="site-foot">
              <span>© 2026 Digvijay Rathore</span>
              <a href="/impressum">Impressum</a>
              <a href="/privacy">Privacy</a>
            </footer>
          )
        }
      </div>
    </div>
    <script>
      import "../scripts/boot";
    </script>
    <noscript>
      <style>
        .preloader { display: none !important; }
      </style>
    </noscript>
  </body>
</html>
