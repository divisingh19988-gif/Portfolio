---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const works = (await getCollection("work")).filter((entry) => !entry.data.hidden);
  return works.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const num = String(data.order).padStart(2, "0");

// Every piece of media appears once. demo-N.mp4 uses poster-N.jpg as its still,
// so that still is never shown again as a separate screenshot.
const posterFor = (src: string) => {
  const match = src.match(/^(.*)\/demo-(\d+)\.mp4$/);
  const candidate = match ? `${match[1]}/poster-${match[2]}.jpg` : "";
  return candidate && data.screenshots.includes(candidate) ? candidate : data.thumbnail;
};
const demos = data.demos.map((src) => ({ src, poster: posterFor(src) }));
const usedPosters = new Set(demos.map((demo) => demo.poster));
const stills = data.screenshots.filter((src) => !usedPosters.has(src));

const heroDemo = !data.explainer ? demos[0] : undefined;
const heroStill = !data.explainer && !heroDemo ? stills[0] : undefined;
const moreDemos = heroDemo ? demos.slice(1) : demos;
const moreStills = heroStill ? stills.slice(1) : stills;

const situation = data.situation || data.problem;
const actions = data.action.length > 0 ? data.action : data.built ? [data.built] : [];
---

<Base title={`${data.title} | ${site.name}`} description={data.hook} page="case">
  <article class="case" data-screen="CASE" data-case-slug={entry.id}>
    <a class="back" href="/#works">← Index</a>
    <header class="case-head">
      <p class="eyebrow">{num} / Case file</p>
      <h1>{data.title}</h1>
      <p class="hook">{data.hook}</p>
      {data.anonymous && <p class="anon">Built for an in-house Cloud Studios app. The name stays off this page.</p>}
    </header>
    <div class="meta">
      {data.role && (
        <div>
          <span>Role</span>
          <p>{data.role}</p>
        </div>
      )}
      {data.dates && (
        <div>
          <span>Dates</span>
          <p>{data.dates}</p>
        </div>
      )}
      {data.tools.length > 0 && (
        <div>
          <span>Tools</span>
          <p>{data.tools.join(" · ")}</p>
        </div>
      )}
    </div>
    {
      data.explainer && (
        <figure class="feature-film">
          <video
            controls
            muted
            playsinline
            preload="none"
            poster={data.explainerPoster || data.thumbnail}
            width="1600"
            height="900"
            aria-label={`${data.title} explainer`}
          >
            <source data-src={data.explainer} type="video/mp4" />
          </video>
          <button class="play-cover" type="button" data-play-film>
            <span>Play</span>
            {!data.explainerSilent && <small>Sound off until you turn it up</small>}
          </button>
          {data.explainerCaption && <figcaption>{data.explainerCaption}</figcaption>}
        </figure>
      )
    }
    {
      heroDemo && (
        <figure class="case-shot">
          <video data-lazy muted loop controls playsinline preload="none" poster={heroDemo.poster} width="1600" height="900" aria-label={`${data.title} walkthrough`}>
            <source data-src={heroDemo.src} type="video/mp4" />
          </video>
        </figure>
      )
    }
    {
      heroStill && (
        <figure class="case-shot">
          <img src={heroStill} alt={`${data.title} screenshot`} loading="eager" />
        </figure>
      )
    }
    <div class="star">
      {situation && (
        <section class="star-row">
          <header class="star-label">
            <span>01</span>
            <h2>Situation</h2>
          </header>
          <div class="star-text">
            <p>{situation}</p>
          </div>
        </section>
      )}
      {data.task && (
        <section class="star-row">
          <header class="star-label">
            <span>02</span>
            <h2>Task</h2>
          </header>
          <div class="star-text">
            <p>{data.task}</p>
          </div>
        </section>
      )}
      {actions.length > 0 && (
        <section class="star-row">
          <header class="star-label">
            <span>03</span>
            <h2>Action</h2>
          </header>
          <div class="star-text">
            <ul>
              {actions.map((step) => <li>{step}</li>)}
            </ul>
          </div>
        </section>
      )}
      {(data.result || data.results.length > 0 || data.metrics.length > 0) && (
        <section class="star-row">
          <header class="star-label">
            <span>04</span>
            <h2>Result</h2>
          </header>
          <div class="star-text">
            {data.results.length > 0 ? (
              <ul>
                {data.results.map((line) => <li>{line}</li>)}
              </ul>
            ) : (
              data.result && <p>{data.result}</p>
            )}
            {data.metrics.length > 0 && (
              <dl class="star-metrics">
                {data.metrics.map((metric) => (
                  <div>
                    <dt>{metric.label}</dt>
                    <dd>{metric.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </section>
      )}
    </div>
    {
      (moreDemos.length > 0 || moreStills.length > 0) && (
        <section class="case-media">
          <p class="eyebrow">Walkthrough</p>
          {moreDemos.map((demo, index) => (
            <figure class="case-shot">
              <video data-lazy muted loop controls playsinline preload="none" poster={demo.poster} width="1600" height="900" aria-label={`${data.title} walkthrough ${index + 2}`}>
                <source data-src={demo.src} type="video/mp4" />
              </video>
            </figure>
          ))}
          {moreStills.map((src) => (
            <figure class="case-shot">
              <img src={src} alt={`${data.title} screenshot`} loading="lazy" />
            </figure>
          ))}
        </section>
      )
    }
    {
      data.planImage && (
        <figure class="plan-shot">
          <img src={data.planImage} alt="Hand-drawn GEO plan: demand, architecture, prompt pyramid, and the P1 to P4 stack." width="804" height="1068" loading="lazy" />
          {data.planCaption && <figcaption>{data.planCaption}</figcaption>}
        </figure>
      )
    }
    {
      data.next && (
        <section class="case-next">
          <p class="eyebrow">What I'd do next</p>
          <p>{data.next}</p>
        </section>
      )
    }
    <div class="prose">
      <Content />
    </div>
    {
      data.link && (
        <p class="case-link">
          <a class="back" href={data.link} data-case-external-link>
            External link →
          </a>
        </p>
      )
    }
  </article>
  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-play-film]").forEach((button) => {
      button.addEventListener("click", () => {
        const film = button.parentElement?.querySelector("video");
        const source = film?.querySelector("source");
        if (!film || !source) return;
        if (source.dataset.src && !source.getAttribute("src")) {
          source.src = source.dataset.src;
          film.load();
        }
        film.muted = true;
        film.play().catch(() => undefined);
        capture("case_study_explainer_played", {
          case_study_slug: document.querySelector<HTMLElement>("[data-case-slug]")?.dataset.caseSlug || "unknown",
        });
        button.hidden = true;
      });
    });

    const capture = (event: string, properties: Record<string, string>) => {
      (
        window as Window & {
          posthog?: { capture: (eventName: string, eventProperties?: Record<string, string>) => void };
        }
      ).posthog?.capture(event, properties);
    };
    const caseSlug = document.querySelector<HTMLElement>("[data-case-slug]")?.dataset.caseSlug || "unknown";
    document.querySelector<HTMLAnchorElement>("[data-case-external-link]")?.addEventListener("click", () => {
      capture("case_study_external_link_opened", { case_study_slug: caseSlug });
    });
  </script>
</Base>
