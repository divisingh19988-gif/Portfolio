---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Poster from "../../components/Poster.astro";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const works = await getCollection("work");
  return works.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const words = data.title.toUpperCase().split(" ");
const mid = Math.max(1, Math.ceil(words.length / 2));
const line1 = words.slice(0, mid).join(" ");
const line2 = words.slice(mid).join(" ") || "FILE";
---

<Base title={`${data.title} — ${site.name}`} description={data.hook} page="case">
  <article class="case" data-screen="CASE">
    <Poster
      label={data.title}
      line1={line1}
      line2={line2}
      lead={data.hook}
      body={data.problem}
      stamp={`21.11.26 / Case file / Vol.${data.order}`}
      image={data.thumbnail}
      video={data.loop}
      webm={data.loopWebm}
    />
    <div class="case-body">
    <a class="back" href="/#works">← Index</a>
    <p class="eyebrow">{String(data.order).padStart(2, "0")} — Case file</p>
    {data.anonymous && <p class="anon">Built for a consumer audio startup. The name stays off this page.</p>}
    <div class="meta">
      <div>
        <span>Role</span>
        <p class:list={[{ todo: data.role.startsWith("TODO") }]}>{data.role}</p>
      </div>
      <div>
        <span>Dates</span>
        <p class:list={[{ todo: data.dates.startsWith("TODO") }]}>{data.dates}</p>
      </div>
      <div>
        <span>Tools</span>
        <p>{data.tools.join(" · ")}</p>
      </div>
    </div>
    <div class="metric-row">
      {
        data.metrics.map((metric) => (
          <div>
            <span>{metric.label}</span>
            <strong class:list={[{ todo: metric.value.includes("[TODO") }]}>{metric.value}</strong>
          </div>
        ))
      }
    </div>
    <div class="story">
      <section>
        <h2>Problem</h2>
        <p>{data.problem}</p>
      </section>
      <section>
        <h2>What I built</h2>
        <p>{data.built}</p>
        <div class="chips">
          {data.tools.map((tool) => <span class="chip">{tool}</span>)}
        </div>
      </section>
    </div>
    {
      data.explainer && (
        <figure class="feature-film">
          <video
            controls
            muted
            playsinline
            preload="none"
            poster={data.explainerPoster || data.thumbnail}
            width="1600"
            height="900"
            aria-label={`${data.title} explainer`}
          >
            <source data-src={data.explainer} type="video/mp4" />
          </video>
          <button class="play-cover" type="button" data-play-film>
            <span>Play</span>
            <small>Sound off until you turn it up</small>
          </button>
          <figcaption>Buyer asks. Competitors get named. Then the work. Then you are the name.</figcaption>
        </figure>
      )
    }
    {
      data.planImage && (
        <figure class="plan-shot">
          <img src={data.planImage} alt="Hand-drawn GEO plan: demand, architecture, prompt pyramid, and the P1 to P4 stack." width="804" height="1068" loading="lazy" />
          {data.planCaption && <figcaption>{data.planCaption}</figcaption>}
        </figure>
      )
    }
    <div class="shots">
      {
        data.screenshots.map((src, index) => (
          <img src={src} alt={`${data.title}, frame ${index + 1}`} width="1600" height="1000" loading="lazy" />
        ))
      }
    </div>
    {
      data.demos.map((src, index) => (
        <video data-lazy controls playsinline preload="none" poster={data.thumbnail} width="1280" height="720" aria-label={`${data.title} walkthrough ${index + 1}`}>
          <source data-src={src} type="video/mp4" />
        </video>
      ))
    }
    <div class="story">
      <section>
        <h2>Result</h2>
        <p class:list={[{ todo: data.result.includes("[TODO: number]") }]}>{data.result}</p>
      </section>
      {data.next && (
        <section>
          <h2>What I'd do next</h2>
          <p class:list={[{ todo: data.next.includes("[TODO: number]") }]}>{data.next}</p>
        </section>
      )}
    </div>
    <div class="prose">
      <Content />
    </div>
    {
      data.link && (
        <p>
          <a class="back" href={data.link}>
            External link →
          </a>
        </p>
      )
    }
    {
      data.loop && (
        <video data-lazy muted loop playsinline preload="none" poster={data.thumbnail} width="1280" height="720" aria-label={`${data.title} loop`}>
          {data.loopWebm && <source data-src={data.loopWebm} type="video/webm" />}
          <source data-src={data.loop} type="video/mp4" />
        </video>
      )
    }
    </div>
  </article>
  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-play-film]").forEach((button) => {
      button.addEventListener("click", () => {
        const film = button.parentElement?.querySelector("video");
        const source = film?.querySelector("source");
        if (!film || !source) return;
        if (source.dataset.src && !source.getAttribute("src")) {
          source.src = source.dataset.src;
          film.load();
        }
        film.muted = true;
        film.play().catch(() => undefined);
        button.hidden = true;
      });
    });
  </script>
</Base>
